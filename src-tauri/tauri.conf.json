{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness Desktop",
  "version": "1.1.1",
  "identifier": "io.github.xlcyun.dsh-desktop",
  "build": {
    "beforeDevCommand": "pnpm build",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/startup"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../dist/assets/dsh-desktop-logo.png"],
    "resources": {
      "../dist/**/*": "dist",
      "../resources/node/**/*": "node"
    }
  }
}
