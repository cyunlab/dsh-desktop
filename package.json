{
  "name": "deepseek-harness-desktop",
  "version": "2.0.17",
  "private": true,
  "type": "module",
  "productName": "DeepSeek Harness Desktop",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm --filter @cyunlab/dsh-desktop-update-client build && node scripts/build.mjs",
    "icons:generate": "node scripts/generate-desktop-icons.mjs",
    "package": "pnpm tauri:build",
    "package:dir": "pnpm tauri:build",
    "package:e2e": "pnpm tauri:build",
    "dev": "pnpm tauri:dev",
    "ensure:official-node": "node scripts/ensure-official-node.mjs",
    "smoke:dsh-cli": "node scripts/smoke-dsh-cli.mjs",
    "tauri:dev": "pnpm ensure:official-node && node scripts/run-tauri.mjs dev",
    "tauri:build": "pnpm ensure:official-node && node scripts/run-tauri.mjs build",
    "start": "pnpm tauri:dev",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:xvfb": "xvfb-run --auto-servernum pnpm test:e2e",
    "test:e2e:release-guard": "node scripts/check-wdio-release-guard.mjs",
    "test:behavior": "pnpm test && pnpm test:integration && pnpm test:e2e",
    "typecheck": "tsc --noEmit && pnpm --filter @cyunlab/dsh-desktop-capabilities typecheck && pnpm --filter @cyunlab/dsh-desktop-update-client typecheck",
    "release:tag": "node scripts/tag-release.mjs",
    "release:promote": "node scripts/promote-stable-release.mjs",
    "verify:release-version": "node scripts/verify-release-version.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.8.4",
    "@types/js-yaml": "4.0.9",
    "@types/mocha": "10.0.10",
    "@types/node": "24.10.1",
    "@wdio/cli": "9.31.1",
    "@wdio/globals": "9.31.1",
    "@wdio/local-runner": "9.31.1",
    "@wdio/mocha-framework": "9.31.1",
    "@wdio/tauri-plugin": "1.3.0",
    "@wdio/tauri-service": "1.3.0",
    "@wdio/types": "9.31.1",
    "esbuild": "0.27.3",
    "sharp": "0.35.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "dependencies": {
    "@cyunlab/dsh-desktop-capabilities": "workspace:*",
    "@cyunlab/dsh-desktop-update-client": "workspace:*",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/cordis-plugin-hmr": "1.0.16",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/cordis-plugin-timer": "1.1.3",
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.0-rc.6",
    "@deepseek-ai/dsh-app-boot": "0.1.0-rc.6",
    "@deepseek-ai/dsh-atomic-write": "0.1.0-rc.6",
    "@deepseek-ai/dsh-base": "0.1.0-rc.6",
    "@deepseek-ai/dsh-bash-local": "0.1.0-rc.6",
    "@deepseek-ai/dsh-cmdline": "0.1.0-rc.6",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction": "0.1.0-rc.6",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.6",
    "@deepseek-ai/dsh-home-paths": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-launch-environment": "0.1.0-rc.6",
    "@deepseek-ai/dsh-output-retention": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-telemetry": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-title-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.6",
    "@deepseek-ai/dsh-spill": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.6",
    "@deepseek-ai/dsh-web-app": "0.1.0-rc.6",
    "@deepseek-ai/dsh-workflow": "0.1.0-rc.6",
    "@tauri-apps/api": "2.11.1",
    "node-addon-require-builtin": "0.1.5"
  },
  "optionalDependencies": {
    "@deepseek-ai/node-addon-landlock-run-linux-x64": "0.1.1",
    "@img/sharp-darwin-arm64": "0.35.3",
    "@img/sharp-darwin-x64": "0.35.3",
    "@img/sharp-libvips-darwin-arm64": "1.3.2",
    "@img/sharp-libvips-darwin-x64": "1.3.2",
    "@img/sharp-libvips-linux-x64": "1.3.2",
    "@img/sharp-linux-x64": "0.35.3",
    "@img/sharp-win32-x64": "0.35.3",
    "@koromix/koffi-darwin-arm64": "3.1.5",
    "@koromix/koffi-darwin-x64": "3.1.5",
    "@koromix/koffi-linux-x64": "3.1.5",
    "@koromix/koffi-win32-x64": "3.1.5",
    "@vscode/ripgrep-darwin-arm64": "1.18.0",
    "@vscode/ripgrep-darwin-x64": "1.18.0",
    "@vscode/ripgrep-linux-x64": "1.18.0",
    "@vscode/ripgrep-win32-x64": "1.18.0",
    "node-addon-require-builtin-darwin-arm64": "0.1.5",
    "node-addon-require-builtin-darwin-x64": "0.1.5",
    "node-addon-require-builtin-linux-x64-gnu": "0.1.5",
    "node-addon-require-builtin-win32-x64-msvc": "0.1.5"
  }
}
